# ---------------------------------------------------------------------------
# Copy this file to .env and edit every value before starting the stack.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Primary mail domain (Postfix virtual_mailbox_domains / Rspamd local domain).
# This is also the domain used for the demo users' mail attributes.
MAIL_DOMAIN=example.com

# Public hostname of this mail server.  It must have an A/AAAA record and be
# the target of the domain's MX record.  The Let's Encrypt certificate
# (STARTTLS for Postfix/Dovecot) is issued for exactly this name.
MAIL_HOSTNAME=mail.example.com

# LDAP naming context and the admin/rootdn account.
# LDAP_ADMIN_DN is built by Compose as: cn=admin,<LDAP_BASE_DN>
LDAP_BASE_DN=dc=example,dc=com
LDAP_ORGANISATION=Example Inc.
LDAP_ADMIN_PASSWORD=change-me-ldap-admin-password

# Password for the demo users seeded by ldap/bootstrap (jdoe / asmith / taro).
# Delete those entries and this variable in a real deployment.
DEMO_USER_PASSWORD=change-me-demo-user-password

# Let's Encrypt / certbot
CERTBOT_EMAIL=admin@example.com
# 1 = request a production certificate.  Use 1 only after DNS and TCP/80 work;
# otherwise set 0 while testing (the stack then keeps its self-signed cert).
CERTBOT_ENABLED=1
# 1 = use the Let's Encrypt staging CA (no production rate-limit risk).
CERTBOT_STAGING=0
# Host port for certbot's HTTP-01 listener.  Must be 80 in production; change
# it only for local tests where port 80 is already in use.
CERTBOT_HTTP_PORT=80

TZ=Asia/Tokyo
